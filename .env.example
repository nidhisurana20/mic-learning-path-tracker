# Copy this file to .env and fill in your own values.
# The server reads these; nothing here is ever sent to a client.

PORT=3000

# Optional. If left blank, the AI-explanation endpoint automatically falls
# back to a plain templated explanation instead of calling out to an AI API.
AI_API_KEY=

# Any OpenAI-compatible chat completions endpoint works here.
# Default is OpenAI itself. For Gemini, point this at a Gemini
# OpenAI-compatibility endpoint and set AI_MODEL accordingly.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
