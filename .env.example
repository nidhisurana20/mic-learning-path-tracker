# Copy this file to .env and fill in ONE of the providers below.
# The server reads these from process.env - run with, e.g.:
#   OPENAI_API_KEY=sk-... node server.js
# or export them in your shell / use a tool like `dotenv-cli`.

PORT=3000

# Which provider to use: "openai" or "gemini"
AI_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Gemini (used instead, if AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
# AI_MODEL=gemini-1.5-flash

# How long to wait for the AI API before falling back (ms)
AI_TIMEOUT_MS=8000
